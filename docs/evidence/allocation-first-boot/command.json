[
  "qemu-system-aarch64",
  "-machine",
  "virt,virtualization=off,secure=off,gic-version=2",
  "-cpu",
  "max",
  "-accel",
  "tcg,thread=multi",
  "-m",
  "128M",
  "-smp",
  "2",
  "-nodefaults",
  "-no-user-config",
  "-display",
  "none",
  "-monitor",
  "none",
  "-serial",
  "stdio",
  "-no-reboot",
  "-semihosting-config",
  "enable=on,target=native",
  "-kernel",
  "target/aarch64/smp-test/aarch64-unknown-none/release/hematite",
  "-d",
  "int",
  "-D",
  "docs/evidence/allocation-first-boot/exceptions.log",
  "-trace",
  "enable=gic_acknowledge_irq",
  "-trace",
  "enable=gic_cpu_write"
]
