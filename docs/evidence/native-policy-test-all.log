	python3 tools/test_test_elf.py; \
	python3 tools/test_test_space.py; \
	python3 tools/test_test_native.py; \
	python3 tools/check_repository.py; \
	python3 tools/check_safety.py; \
	cargo build --locked --offline -p hm-core --release --features boot-tests --target aarch64-unknown-none --target-dir target/aarch64/boot-test; \
	cargo build --locked --offline -p hm-core --release --target aarch64-unknown-none --target-dir target/aarch64/monitor; \
	if [ "aarch64" = aarch64 ]; then \
		cargo build --locked --offline -p hm-core --release --features unhandled-fault-test --target aarch64-unknown-none --target-dir target/aarch64/fault-test; \
		cargo build --locked --offline -p hm-core --release --features nested-fault-test --target aarch64-unknown-none --target-dir target/aarch64/nested-test; \
		cargo build --locked --offline -p hm-core --release --features thread-overflow-test --target aarch64-unknown-none --target-dir target/aarch64/thread-overflow-test; \
		cargo build --locked --offline -p hm-core --release --features preemption-tests --target aarch64-unknown-none --target-dir target/aarch64/preemption-test; \
		cargo build --locked --offline -p hm-core --release --features preemption-boundary-test --target aarch64-unknown-none --target-dir target/aarch64/preemption-boundary-test; \
		cargo build --locked --offline -p hm-core --release --features preemption-no-timer-test --target aarch64-unknown-none --target-dir target/aarch64/preemption-no-timer-test; \
		cargo build --locked --offline -p hm-core --release --features preemption-overflow-test --target aarch64-unknown-none --target-dir target/aarch64/preemption-overflow-test; \
		cargo build --locked --offline -p hm-core --release --features wait-all-blocked-test --target aarch64-unknown-none --target-dir target/aarch64/wait-all-blocked-test; \
		cargo build --locked --offline -p hm-core --release --features space-tests --target aarch64-unknown-none --target-dir target/aarch64/space-test; \
		cargo build --locked --offline -p hm-core --release --features secondary-tests --target aarch64-unknown-none --target-dir target/aarch64/secondary-test; \
		cargo build --locked --offline -p hm-core --release --features secondary-stale-generation-test --target aarch64-unknown-none --target-dir target/aarch64/secondary-stale-test; \
		cargo build --locked --offline -p hm-core --release --features secondary-cpu-off-return-test --target aarch64-unknown-none --target-dir target/aarch64/secondary-off-return-test; \
		cargo build --locked --offline -p hm-core --release --features smp-tests --target aarch64-unknown-none --target-dir target/aarch64/smp-test; \
		cargo build --locked --offline -p hm-core --release --features smp-no-peer-timer-test --target aarch64-unknown-none --target-dir target/aarch64/smp-no-peer-timer-test; \
		cargo build --locked --offline -p hm-core --release --features smp-peer-overflow-test --target aarch64-unknown-none --target-dir target/aarch64/smp-peer-overflow-test; \
		cargo build --locked --offline -p hm-core --release --features smp-all-blocked-test --target aarch64-unknown-none --target-dir target/aarch64/smp-all-blocked-test; \
	fi; \
	cargo build --locked --offline -p hm-kernel --release --target aarch64-unknown-none --target-dir target/aarch64/boot-test; \
	python3 tools/check_capability_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/type-boundary"; \
	python3 tools/check_native_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/native-types"; \
	python3 tools/check_elf_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/elf-types"; \
	python3 tools/check_frame_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/frame-types"; \
	mutex_host_args=(); \
	if [ "aarch64" = aarch64 ]; then \
		cargo build --locked --offline -p hm-kernel --release --target x86_64-unknown-linux-gnu --target-dir target/host-mutex; \
		python3 tools/check_native.py --output "$evidence_dir/native-host"; \
		python3 tools/check_elf.py --library target/host-mutex/x86_64-unknown-linux-gnu/release/libhm_kernel.rlib --output "$evidence_dir/elf-host"; \
		python3 tools/check_cpu_topology.py --library target/host-mutex/x86_64-unknown-linux-gnu/release/libhm_kernel.rlib --output "$evidence_dir/cpu-topology"; \
		mutex_host_args=(--host-library target/host-mutex/x86_64-unknown-linux-gnu/release/libhm_kernel.rlib); \
	fi; \
	python3 tools/check_mutex_types.py \
