		--target aarch64-unknown-none --output "$evidence_dir/mutex-types" "${mutex_host_args[@]}"; \
	if [ "aarch64" = aarch64 ]; then \
		python3 tools/check_space_types.py \
			--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
			--target aarch64-unknown-none --output "$evidence_dir/space-types"; \
		python3 tools/check_mapping_types.py \
			--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
			--target aarch64-unknown-none --output "$evidence_dir/mapping-types"; \
		python3 tools/check_thread_types.py \
			--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
			--target aarch64-unknown-none --output "$evidence_dir/thread-types"; \
	fi; \
	python3 tools/test_kernel.py \
		--kernel target/aarch64/boot-test/aarch64-unknown-none/release/hematite \
		--output "$evidence_dir/boot" --accel tcg --arch aarch64; \
	python3 tools/test_boot_profiles.py \
		--test-kernel target/aarch64/boot-test/aarch64-unknown-none/release/hematite \
		--monitor-kernel target/aarch64/monitor/aarch64-unknown-none/release/hematite \
		--fault-kernel target/aarch64/fault-test/aarch64-unknown-none/release/hematite \
		--nested-kernel target/aarch64/nested-test/aarch64-unknown-none/release/hematite \
		--thread-overflow-kernel target/aarch64/thread-overflow-test/aarch64-unknown-none/release/hematite \
		--output "$evidence_dir/profiles" --arch aarch64; \
	if [ "aarch64" = aarch64 ]; then \
		python3 tools/test_preemption.py --kernel target/aarch64/preemption-test/aarch64-unknown-none/release/hematite --output "$evidence_dir/preemption-128m"; \
		python3 tools/test_preemption.py --kernel target/aarch64/preemption-test/aarch64-unknown-none/release/hematite --memory 64 --output "$evidence_dir/preemption-64m"; \
		python3 tools/test_preemption.py --kernel target/aarch64/preemption-boundary-test/aarch64-unknown-none/release/hematite --boundaries --output "$evidence_dir/preemption-boundaries"; \
		python3 tools/test_preemption_negative.py --no-timer-kernel target/aarch64/preemption-no-timer-test/aarch64-unknown-none/release/hematite --overflow-kernel target/aarch64/preemption-overflow-test/aarch64-unknown-none/release/hematite --output "$evidence_dir/preemption-negative"; \
		python3 tools/test_wait_blocked.py --kernel target/aarch64/wait-all-blocked-test/aarch64-unknown-none/release/hematite --output "$evidence_dir/wait-all-blocked"; \
		python3 tools/test_space.py --kernel target/aarch64/space-test/aarch64-unknown-none/release/hematite --output "$evidence_dir/space"; \
		python3 tools/test_secondary.py --kernel target/aarch64/secondary-test/aarch64-unknown-none/release/hematite --stale-generation-kernel target/aarch64/secondary-stale-test/aarch64-unknown-none/release/hematite --cpu-off-return-kernel target/aarch64/secondary-off-return-test/aarch64-unknown-none/release/hematite --output "$evidence_dir/secondary"; \
		python3 tools/test_smp.py --kernel target/aarch64/smp-test/aarch64-unknown-none/release/hematite --no-peer-timer-kernel target/aarch64/smp-no-peer-timer-test/aarch64-unknown-none/release/hematite --peer-overflow-kernel target/aarch64/smp-peer-overflow-test/aarch64-unknown-none/release/hematite --all-blocked-kernel target/aarch64/smp-all-blocked-test/aarch64-unknown-none/release/hematite --output "$evidence_dir/smp"; \
