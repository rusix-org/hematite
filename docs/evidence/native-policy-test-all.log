bash tools/dev.sh bash -eu -c '\
	evidence_dir="target/evidence/$(date -u +%Y%m%dT%H%M%S-%N)-aarch64"; \
	mkdir -p "$evidence_dir"; \
	{ rustc --version; cargo --version; qemu-system-aarch64 --version; \
		if [ "aarch64" = x86_64 ]; then sha256sum /usr/share/qemu/bios-microvm.bin; \
		else printf "Boot: direct ELF; no external firmware.\n"; fi; \
	} > "$evidence_dir/environment.log"; \
	cargo fmt --all -- --check; \
	cargo clippy --workspace --all-features --locked --offline --target aarch64-unknown-none --target-dir target/aarch64/clippy -- -D warnings; \
	python3 tools/test_test_kernel.py; \
	python3 tools/test_timer_trace.py; \
	python3 tools/test_test_preemption.py; \
	python3 tools/test_test_preemption_negative.py; \
