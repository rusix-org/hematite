bash tools/dev.sh bash -eu -c '\
	evidence_dir="target/evidence/$(date -u +%Y%m%dT%H%M%S-%N)-aarch64"; \
	mkdir -p "$evidence_dir"; \
	{ rustc --version; cargo --version; qemu-system-aarch64 --version; \
		if [ "aarch64" = x86_64 ]; then sha256sum /usr/share/qemu/bios-microvm.bin; \
		else printf "Boot: direct ELF; no external firmware.\n"; fi; \
	} > "$evidence_dir/environment.log"; \
	cargo fmt --all -- --check; \
	cargo clippy --workspace --all-features --locked --offline --target aarch64-unknown-none --target-dir target/aarch64/clippy -- -D warnings; \
	python3 tools/test_test_kernel.py; \
	python3 tools/test_timer_trace.py; \
	python3 tools/check_repository.py; \
	python3 tools/check_safety.py; \
	cargo build --locked --offline -p hm-core --release --features boot-tests --target aarch64-unknown-none --target-dir target/aarch64/boot-test; \
	cargo build --locked --offline -p hm-core --release --target aarch64-unknown-none --target-dir target/aarch64/monitor; \
	if [ "aarch64" = aarch64 ]; then \
		cargo build --locked --offline -p hm-core --release --features unhandled-fault-test --target aarch64-unknown-none --target-dir target/aarch64/fault-test; \
		cargo build --locked --offline -p hm-core --release --features nested-fault-test --target aarch64-unknown-none --target-dir target/aarch64/nested-test; \
		cargo build --locked --offline -p hm-core --release --features thread-overflow-test --target aarch64-unknown-none --target-dir target/aarch64/thread-overflow-test; \
	fi; \
	cargo build --locked --offline -p hm-kernel --release --target aarch64-unknown-none --target-dir target/aarch64/boot-test; \
	python3 tools/check_capability_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/type-boundary"; \
	python3 tools/check_frame_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/frame-types"; \
	mutex_host_args=(); \
	if [ "aarch64" = aarch64 ]; then \
		cargo build --locked --offline -p hm-kernel --release --target x86_64-unknown-linux-gnu --target-dir target/host-mutex; \
		mutex_host_args=(--host-library target/host-mutex/x86_64-unknown-linux-gnu/release/libhm_kernel.rlib); \
	fi; \
	python3 tools/check_mutex_types.py \
		--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
		--target aarch64-unknown-none --output "$evidence_dir/mutex-types" "${mutex_host_args[@]}"; \
	if [ "aarch64" = aarch64 ]; then \
		python3 tools/check_mapping_types.py \
			--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
			--target aarch64-unknown-none --output "$evidence_dir/mapping-types"; \
		python3 tools/check_thread_types.py \
			--library target/aarch64/boot-test/aarch64-unknown-none/release/libhm_kernel.rlib \
			--target aarch64-unknown-none --output "$evidence_dir/thread-types"; \
	fi; \
	python3 tools/test_kernel.py \
		--kernel target/aarch64/boot-test/aarch64-unknown-none/release/hematite \
		--output "$evidence_dir/boot" --accel tcg --arch aarch64; \
	python3 tools/test_boot_profiles.py \
		--test-kernel target/aarch64/boot-test/aarch64-unknown-none/release/hematite \
		--monitor-kernel target/aarch64/monitor/aarch64-unknown-none/release/hematite \
		--fault-kernel target/aarch64/fault-test/aarch64-unknown-none/release/hematite \
		--nested-kernel target/aarch64/nested-test/aarch64-unknown-none/release/hematite \
		--thread-overflow-kernel target/aarch64/thread-overflow-test/aarch64-unknown-none/release/hematite \
		--output "$evidence_dir/profiles" --arch aarch64; \
	if [ "aarch64" = aarch64 ]; then \
		python3 tools/check_timer_trace.py --trace "$evidence_dir/boot/exceptions.log" \
			--expected 16 --output "$evidence_dir/boot/timer-trace.json"; \
		python3 tools/check_timer_trace.py --trace "$evidence_dir/profiles/monitor/exceptions.log" \
			--expected 32 --output "$evidence_dir/profiles/monitor/timer-trace.json"; \
		python3 tools/check_timer_trace.py --trace "$evidence_dir/profiles/memory-64m/exceptions.log" \
			--expected 32 --output "$evidence_dir/profiles/memory-64m/timer-trace.json"; \
	fi'
