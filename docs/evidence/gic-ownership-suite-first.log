		cargo build --locked --offline -p hm-core --release --features preemption-no-timer-test --target x86_64-unknown-none --target-dir target/x86_64/preemption-no-timer-test; \
		cargo build --locked --offline -p hm-core --release --features preemption-overflow-test --target x86_64-unknown-none --target-dir target/x86_64/preemption-overflow-test; \
		cargo build --locked --offline -p hm-core --release --features wait-all-blocked-test --target x86_64-unknown-none --target-dir target/x86_64/wait-all-blocked-test; \
	fi; \
	cargo build --locked --offline -p hm-kernel --release --target x86_64-unknown-none --target-dir target/x86_64/boot-test; \
