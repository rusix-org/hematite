[
  "qemu-system-aarch64",
  "-machine",
  "virt,virtualization=off,secure=off,gic-version=2",
  "-cpu",
  "max",
  "-accel",
  "tcg",
  "-m",
  "128M",
  "-smp",
  "1",
  "-nodefaults",
  "-no-user-config",
  "-display",
  "none",
  "-monitor",
  "none",
  "-serial",
  "stdio",
  "-no-reboot",
  "-semihosting-config",
  "enable=on,target=native,userspace=off",
  "-kernel",
  "/workspace/target/idle-candidates/idle-candidates-third/aarch64-idle-short/aarch64-unknown-none/release/hematite",
  "-d",
  "exec,nochain,in_asm,int",
  "-dfilter",
  "0x402015ac..0x402015bb",
  "-D",
  "docs/evidence/idle/guest-third-short128/short128/trace.log",
  "-trace",
  "enable=gic_acknowledge_irq",
  "-trace",
  "enable=gic_cpu_write"
]
